# ─── Database (PostgreSQL: Neon, Supabase, Prisma Postgres, RDS…) ───────────────
# App connection. On serverless (Vercel) use your provider's POOLED connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# Optional: direct (non-pooled) connection used only by migrations/seed.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────────────────────
# 32+ random characters. Generate with:  openssl rand -base64 48
AUTH_SECRET=""
# Public site URL — used in magic links and email buttons (no trailing slash)
APP_URL="https://www.chefdeserene.com"
# "true" lets new portal signups order immediately; otherwise an admin approves them
AUTO_APPROVE_SIGNUPS="false"

# ─── Email (Resend — https://resend.com) ──────────────────────────────────────────
# Without a key, emails are printed to the server console (local development).
RESEND_API_KEY=""
# Must be on a domain verified in Resend
EMAIL_FROM="Chef de Serene <concierge@chefdeserene.net>"
# Where inquiry / order / signup alerts go (comma-separated for several)
NOTIFY_EMAIL="Dwayne@chefdeserene.net"
# Optional: Resend → Webhooks signing secret for /api/webhooks/resend
# RESEND_WEBHOOK_SECRET="whsec_..."

# ─── Optional SMS alerts for new inquiries (Twilio) ──────────────────────────────
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+1..."
# NOTIFY_SMS_TO="+1..."

# ─── Seeding (npm run db:seed) ─────────────────────────────────────────────────────
# SEED_ADMIN_EMAIL="dwayne@chefdeserene.net"
# SEED_ADMIN_PASSWORD="choose-a-strong-passcode"
# SEED_DEMO="false"   # skip the demo client account in production
